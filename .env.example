# Option 1: Full PostgreSQL connection URL (standard for Render / Neon / Supabase / Railway)
DATABASE_URL=postgresql://postgres:password@localhost:5432/adityawandhare

# Option 2: Individual variables
PGHOST=localhost
PGPORT=5432
PGDATABASE=adityawandhare
PGUSER=postgres
PGPASSWORD=your_password

# Web server port
PORT=5000
